{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "port": {
          "default": "success",
          "pattern": "^(success|error|case:[0-9]{1,3})$",
          "title": "Port",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "action_version": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Action Version",
          "type": "integer"
        },
        "title": {
          "default": "",
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "x": {
          "default": 60,
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 60,
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Y",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "breakpoint": {
          "default": false,
          "title": "Breakpoint",
          "type": "boolean"
        },
        "save_as": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Save As"
        },
        "result_path": {
          "default": "",
          "maxLength": 200,
          "title": "Result Path",
          "type": "string"
        },
        "protect_result": {
          "default": false,
          "title": "Protect Result",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "default": null,
          "title": "Value"
        },
        "input": {
          "default": false,
          "title": "Input",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "title": "Variable",
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "zoom": {
          "default": 1,
          "maximum": 3,
          "minimum": 0.25,
          "title": "Zoom",
          "type": "number"
        }
      },
      "title": "View",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "poster.maker.graph",
      "default": "poster.maker.graph",
      "title": "Format",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "default": "Новый проект",
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "entry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 2000,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 4000,
      "title": "Edges",
      "type": "array"
    },
    "view": {
      "$ref": "#/$defs/View"
    },
    "max_steps": {
      "default": 500,
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Steps",
      "type": "integer"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "secret_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secret File"
    },
    "secret_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secret Sha256"
    },
    "variables": {
      "additionalProperties": {
        "$ref": "#/$defs/Variable"
      },
      "maxProperties": 1000,
      "title": "Variables",
      "type": "object"
    }
  },
  "title": "Graph",
  "type": "object"
}
