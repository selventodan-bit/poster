    {
      "type": "Variables.Set",
      "action_version": 1,
      "label": "Переменные · Set",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": "value",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Name",
            "type": "string"
          },
          "value": {
            "default": "",
            "title": "Value"
          }
        },
        "title": "Set",
        "type": "object"
      }
    },
    {
      "type": "Variables.Get",
      "action_version": 1,
      "label": "Переменные · Get",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": "value",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Name",
            "type": "string"
          }
        },
        "title": "Named",
        "type": "object"
      }
    },
    {
      "type": "Variables.Delete",
      "action_version": 1,
      "label": "Переменные · Delete",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": "value",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Name",
            "type": "string"
          }
        },
        "title": "Named",
        "type": "object"
      }
    },
    {
      "type": "Variables.Increment",
      "action_version": 1,
