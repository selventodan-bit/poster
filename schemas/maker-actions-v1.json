          "index": {
            "default": "i",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Index",
            "type": "string"
          },
          "max_iterations": {
            "default": 1000,
            "maximum": 10000,
            "minimum": 1,
            "title": "Max Iterations",
            "type": "integer"
          }
        },
        "title": "Loop",
        "type": "object"
      }
    },
