            "type": "array"
          },
          "item": {
            "default": "item",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Item",
            "type": "string"
          },
          "index": {
            "default": "i",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
