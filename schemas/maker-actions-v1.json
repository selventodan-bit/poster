      "parameters": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "default": "value",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
            "title": "Name",
            "type": "string"
          },
          "amount": {
            "default": 1.0,
            "title": "Amount",
            "type": "number"
          }
        },
        "title": "Increment",
        "type": "object"
      }
    },
    {
      "type": "Variables.Compare",
      "action_version": 1,
      "label": "Переменные · Compare / If",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "default": 0,
            "title": "Left"
          },
          "right": {
            "default": 0,
            "title": "Right"
          },
          "operator": {
            "default": "equals",
            "enum": [
              "equals",
              "not_equals",
              "lt",
              "le",
              "gt",
              "ge",
              "contains",
              "starts_with",
              "ends_with"
            ],
            "title": "Operator",
            "type": "string"
          }
        },
        "title": "Compare",
        "type": "object"
      }
    },
    {
      "type": "Strings.Transform",
      "action_version": 1,
      "label": "Строки · Операция",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "default": "concat",
            "enum": [
              "concat",
              "replace",
              "lower",
              "upper",
              "strip",
              "split",
              "join",
              "length",
              "substring"
            ],
            "title": "Operation",
            "type": "string"
          },
          "value": {
            "default": "",
            "title": "Value"
          },
          "other": {
            "default": "",
            "title": "Other"
          },
          "replacement": {
            "default": "",
            "title": "Replacement",
            "type": "string"
          },
          "separator": {
            "default": ",",
            "title": "Separator",
            "type": "string"
          },
          "start": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Start",
            "type": "integer"
          },
          "end": {
            "anyOf": [
              {
                "maximum": 1000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "title": "String",
        "type": "object"
      }
    },
    {
      "type": "Logic.Switch",
      "action_version": 1,
      "label": "Логика · Switch",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "default": "",
            "title": "Value"
          },
          "cases": {
            "items": {},
            "maxItems": 20,
            "title": "Cases",
            "type": "array"
          }
        },
        "title": "Switch",
        "type": "object"
      }
    },
    {
      "type": "Logic.Loop",
      "action_version": 1,
      "label": "Логика · Цикл N раз",
