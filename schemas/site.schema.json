{
  "$defs": {
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "max_concurrent": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Concurrent",
          "type": "integer"
        },
        "min_interval_seconds": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Min Interval Seconds",
          "type": "number"
        }
      },
      "title": "Schedule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Id",
      "type": "string"
    },
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Hosts",
      "type": "array"
    },
    "mode": {
      "default": "http",
      "enum": [
        "http",
        "browser"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "default": "REVIEW",
      "enum": [
        "NEW",
        "HTTP_READY",
        "REVIEW",
        "BROWSER_REQUIRED",
        "DISABLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "workflow": {
      "default": "workflow.yaml",
      "title": "Workflow",
      "type": "string"
    },
    "auth_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth File"
    },
    "campaign": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign"
    },
    "schedule": {
      "$ref": "#/$defs/Schedule",
      "default": {
        "max_concurrent": 1,
        "min_interval_seconds": 0.0
      }
    },
    "timeout": {
      "default": 20,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout",
      "type": "number"
    },
    "get_retries": {
      "default": 2,
      "maximum": 5,
      "minimum": 0,
      "title": "Get Retries",
      "type": "integer"
    },
    "retry_delay": {
      "default": 0.25,
      "maximum": 60,
      "minimum": 0,
      "title": "Retry Delay",
      "type": "number"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Headers",
      "type": "object"
    }
  },
  "required": [
    "id",
    "base_url",
    "allowed_hosts"
  ],
  "title": "Site",
  "type": "object"
}
