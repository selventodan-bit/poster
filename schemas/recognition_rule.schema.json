{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "maximum": 19,
          "minimum": 0,
          "title": "Operation",
          "type": "integer"
        },
        "target": {
          "maximum": 299,
          "minimum": 0,
          "title": "Target",
          "type": "integer"
        },
        "target_kind": {
          "default": "payload",
          "enum": [
            "payload",
            "path",
            "query",
            "header"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "parent": {
          "maximum": 19,
          "minimum": -1,
          "title": "Parent",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "json_path",
            "css_attribute",
            "header",
            "cookie",
            "regex"
          ],
          "title": "Kind",
          "type": "string"
        },
        "slot": {
          "maximum": 299,
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "role": {
          "default": "fresh",
          "enum": [
            "identity",
            "fresh"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "target",
        "parent",
        "kind",
        "slot"
      ],
      "title": "Binding",
      "type": "object"
    },
    "EngineKnowledge": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "default": "unknown",
          "enum": [
            "unknown",
            "xenforo",
            "phpbb",
            "vbulletin",
            "mybb",
            "discourse",
            "smf",
            "invision",
            "flarum",
            "wordpress",
            "wpforo"
          ],
          "title": "Family",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "adapter_revision": {
          "default": 2,
          "maximum": 100,
          "minimum": 1,
          "title": "Adapter Revision",
          "type": "integer"
        },
        "channels": {
          "items": {
            "enum": [
              "generator",
              "assets",
              "routes",
              "api",
              "dom",
              "behavior",
              "headers"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Channels",
          "type": "array"
        }
      },
      "title": "EngineKnowledge",
      "type": "object"
    },
    "FormKnowledge": {
      "additionalProperties": false,
      "properties": {
        "editor_adapter": {
          "default": "native",
          "enum": [
            "native",
            "tinymce",
            "ckeditor",
            "quill",
            "prosemirror",
            "summernote",
            "froala"
          ],
          "title": "Editor Adapter",
          "type": "string"
        },
        "title_features": {
          "items": {
            "enum": [
              "previous-stage",
              "single-line",
              "multiline-editor",
              "semantic-attributes",
              "accessible-label",
              "before-editor",
              "after-editor",
              "unique-title-near-editor",
              "form-submit-control",
              "accessible-publication-intent"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Title Features",
          "type": "array"
        },
        "layout": {
          "items": {
            "enum": [
              "light",
              "shadow",
              "dialog",
              "inline"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Layout",
          "type": "array"
        },
        "input_count": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Input Count",
          "type": "integer"
        }
      },
      "title": "FormKnowledge",
      "type": "object"
    },
    "HTTPTemplate": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "const": 1,
          "default": 1,
          "title": "Revision",
          "type": "integer"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "maxItems": 20,
          "title": "Operations",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "maxItems": 100,
          "title": "Bindings",
          "type": "array"
        },
        "independent_content_verification": {
          "const": true,
          "default": true,
          "title": "Independent Content Verification",
          "type": "boolean"
        }
      },
      "required": [
        "operations"
      ],
      "title": "HTTPTemplate",
      "type": "object"
    },
    "NavigationKnowledge": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/NavigationStep"
          },
          "maxItems": 5,
          "title": "Steps",
          "type": "array"
        }
      },
      "title": "NavigationKnowledge",
      "type": "object"
    },
    "NavigationStep": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "menu",
            "compose"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "evidence": {
          "items": {
            "enum": [
              "accessible-compose-intent",
              "compose-route",
              "compose-affordance",
              "controlled-editor",
              "controlled-menu",
              "navigation-link",
              "non-submit-control",
              "navigation-context"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "purpose",
        "evidence",
        "score"
      ],
      "title": "NavigationStep",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "POST",
            "PUT",
            "PATCH"
          ],
          "title": "Method",
          "type": "string"
        },
        "encoding": {
          "enum": [
            "form",
            "multipart",
            "json"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "title",
              "body"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Roles",
          "type": "array"
        },
        "shape": {
          "items": {
            "enum": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ],
            "type": "string"
          },
          "maxItems": 300,
          "title": "Shape",
          "type": "array"
        },
        "route": {
          "default": "other",
          "enum": [
            "draft",
            "publish",
            "other"
          ],
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "method",
        "encoding",
        "roles",
        "shape"
      ],
      "title": "Operation",
      "type": "object"
    },
    "SubmissionDependency": {
      "additionalProperties": false,
      "properties": {
        "parent": {
          "maximum": 20,
          "minimum": 0,
          "title": "Parent",
          "type": "integer"
        },
        "child": {
          "maximum": 20,
          "minimum": 0,
          "title": "Child",
          "type": "integer"
        },
        "source": {
          "enum": [
            "json_path",
            "header"
          ],
          "title": "Source",
          "type": "string"
        },
        "target": {
          "enum": [
            "payload",
            "path",
            "query",
            "header"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "parent",
        "child",
        "source",
        "target"
      ],
      "title": "SubmissionDependency",
      "type": "object"
    },
    "SubmissionKnowledge": {
      "additionalProperties": false,
      "properties": {
        "operations": {
          "items": {
            "$ref": "#/$defs/SubmissionOperation"
          },
          "maxItems": 20,
          "title": "Operations",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/SubmissionDependency"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        }
      },
      "title": "SubmissionKnowledge",
      "type": "object"
    },
    "SubmissionOperation": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "encoding": {
          "enum": [
            "json",
            "form",
            "multipart"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "title",
              "body"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Roles",
          "type": "array"
        },
        "body_shape": {
          "items": {
            "enum": [
              "object",
              "array",
              "scalar",
              "dynamic",
              "title",
              "body"
            ],
            "type": "string"
          },
          "maxItems": 100,
          "title": "Body Shape",
          "type": "array"
        },
        "route": {
          "default": "other",
          "enum": [
            "draft",
            "publish",
            "other"
          ],
          "title": "Route",
          "type": "string"
        },
        "route_shape": {
          "items": {
            "enum": [
              "api",
              "draft",
              "drafts",
              "publish",
              "threads",
              "topics",
              "posts",
              "identity",
              "other"
            ],
            "type": "string"
          },
          "maxItems": 30,
          "title": "Route Shape",
          "type": "array"
        }
      },
      "required": [
        "method",
        "encoding",
        "roles"
      ],
      "title": "SubmissionOperation",
      "type": "object"
    },
    "TokenKnowledge": {
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "items": {
            "$ref": "#/$defs/TokenPattern"
          },
          "maxItems": 100,
          "title": "Patterns",
          "type": "array"
        }
      },
      "title": "TokenKnowledge",
      "type": "object"
    },
    "TokenPattern": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "csrf_token",
            "csrf",
            "nonce",
            "token",
            "x-csrf-token",
            "x-xsrf-token",
            "id",
            "draft_id",
            "topic_id",
            "uuid",
            "other"
          ],
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "csrf",
            "identity",
            "nonce"
          ],
          "title": "Role",
          "type": "string"
        },
        "source": {
          "enum": [
            "html-hidden",
            "html-meta",
            "json",
            "header",
            "cookie",
            "javascript",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "fresh": {
          "default": true,
          "title": "Fresh",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "role",
        "source"
      ],
      "title": "TokenPattern",
      "type": "object"
    },
    "VerificationKnowledge": {
      "additionalProperties": false,
      "properties": {
        "permalink": {
          "default": "unknown",
          "enum": [
            "json",
            "bookmark",
            "redirect",
            "unknown"
          ],
          "title": "Permalink",
          "type": "string"
        },
        "content": {
          "items": {
            "enum": [
              "title",
              "body"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Content",
          "type": "array"
        },
        "independent_get": {
          "default": true,
          "title": "Independent Get",
          "type": "boolean"
        },
        "rejected": {
          "items": {
            "enum": [
              "http-error",
              "login",
              "explicit-error",
              "missing-content",
              "missing-permalink"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Rejected",
          "type": "array"
        }
      },
      "title": "VerificationKnowledge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^form-[a-f0-9]{16}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 2,
      "maximum": 2,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "scope": {
      "const": "form-structure",
      "default": "form-structure",
      "title": "Scope",
      "type": "string"
    },
    "algorithm": {
      "default": "relational-workflow-v2",
      "enum": [
        "semantic-editor-pair-v1",
        "relational-workflow-v2"
      ],
      "title": "Algorithm",
      "type": "string"
    },
    "editor": {
      "enum": [
        "input",
        "textarea",
        "contenteditable",
        "iframe:contenteditable",
        "iframe:textarea"
      ],
      "title": "Editor",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "title",
          "body",
          "submit",
          "category",
          "tags",
          "csrf"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "title": "Roles",
      "type": "array"
    },
    "source": {
      "enum": [
        "browser-observation",
        "manual-observation"
      ],
      "title": "Source",
      "type": "string"
    },
    "tests": {
      "items": {
        "enum": [
          "browser-permalink",
          "http-permalink"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "title": "Tests",
      "type": "array"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "browser_successes": {
      "default": 0,
      "minimum": 0,
      "title": "Browser Successes",
      "type": "integer"
    },
    "http_successes": {
      "default": 0,
      "minimum": 0,
      "title": "Http Successes",
      "type": "integer"
    },
    "failures": {
      "default": 0,
      "minimum": 0,
      "title": "Failures",
      "type": "integer"
    },
    "title_text_index": {
      "default": 0,
      "maximum": 30,
      "minimum": 0,
      "title": "Title Text Index",
      "type": "integer"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "priority": {
      "default": 0,
      "maximum": 100,
      "minimum": -100,
      "title": "Priority",
      "type": "integer"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "regressions": {
      "default": 0,
      "minimum": 0,
      "title": "Regressions",
      "type": "integer"
    },
    "installations": {
      "items": {
        "pattern": "^[a-f0-9]{16}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Installations",
      "type": "array"
    },
    "http_installations": {
      "items": {
        "pattern": "^[a-f0-9]{16}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Http Installations",
      "type": "array"
    },
    "variants": {
      "items": {
        "pattern": "^[a-f0-9]{16}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Variants",
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EngineKnowledge"
    },
    "navigation": {
      "$ref": "#/$defs/NavigationKnowledge"
    },
    "form": {
      "$ref": "#/$defs/FormKnowledge"
    },
    "submission": {
      "$ref": "#/$defs/SubmissionKnowledge"
    },
    "tokens": {
      "$ref": "#/$defs/TokenKnowledge"
    },
    "verification": {
      "$ref": "#/$defs/VerificationKnowledge"
    },
    "http_templates": {
      "items": {
        "$ref": "#/$defs/HTTPTemplate"
      },
      "maxItems": 8,
      "title": "Http Templates",
      "type": "array"
    }
  },
  "required": [
    "id",
    "editor",
    "roles",
    "source"
  ],
  "title": "Rule",
  "type": "object"
}
